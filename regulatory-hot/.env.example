# ===========================================================================
# Regulatory Hot — 环境变量配置
# 复制此文件为 .env 并填入真实值
# ===========================================================================

# ---------- 硅基流动 (SiliconFlow) ----------
# 获取 API Key: https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ---------- 模型配置 ----------
# 第一级：预筛模型（便宜快速）
PRE_FILTER_MODEL=deepseek-ai/DeepSeek-V3.2

# 第二级：五维评分 + 翻译 + 摘要
SCORING_MODEL=deepseek-ai/DeepSeek-V3.1-Terminus

# 第三级：Embedding 聚类
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# 第四级：Reranker 精排（可选）
RERANKER_MODEL=Qwen/Qwen3-Reranker-8B

# 备选精评模型（MoE 高效）
ALT_SCORING_MODEL=Qwen/Qwen3.5-35B-A3B

# ---------- 应用配置 ----------
NEXT_PUBLIC_SITE_URL=http://47.107.133.169:3457
