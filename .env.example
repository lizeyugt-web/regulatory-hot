# 全球药械监管信息采集监控平台
# Global Regulatory Intelligence Monitoring Platform

# 环境配置
PORT=3456
HOST=0.0.0.0

# 采集配置
CRAWL_INTERVAL_HOURS=12

# AI 分析配置 (Claude API)
ANTHROPIC_API_KEY=
